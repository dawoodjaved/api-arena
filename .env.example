# Database
DATABASE_URL="postgresql://dawoodjaveed@localhost:5432/api_arena?schema=public"

# Auth (required)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_SECRET="same-as-NEXTAUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# OAuth (optional — social sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Stripe test mode (optional — required for Pro checkout / portal)
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Redis (optional — falls back to in-memory if down)
REDIS_URL="redis://localhost:6379"

# Cron protection (optional)
CRON_SECRET=""

# Kong Gateway (optional)
KONG_ENABLED=false
KONG_ADMIN_URL=http://localhost:8001
KONG_API_URL=http://localhost:8000
