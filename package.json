{
  "name": "api-arena",
  "version": "1.0.0",
  "description": "API Marketplace & Management Platform",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:approve": "npx tsx scripts/approve-apis.ts",
    "catalog:sync": "PYTHONUNBUFFERED=1 scripts/catalog/.venv/bin/python scripts/catalog/sync_catalog.py",
    "catalog:sync:dry": "PYTHONUNBUFFERED=1 scripts/catalog/.venv/bin/python scripts/catalog/sync_catalog.py --dry-run",
    "catalog:hydrate": "PYTHONUNBUFFERED=1 scripts/catalog/.venv/bin/python scripts/catalog/sync_catalog.py --skip-fetch --hydrate --hydrate-limit 250",
    "catalog:seed": "PYTHONUNBUFFERED=1 scripts/catalog/.venv/bin/python scripts/catalog/sync_catalog.py --hydrate --hydrate-limit 200 && npx tsx prisma/seed.ts",
    "catalog:venv": "python3 -m venv scripts/catalog/.venv && scripts/catalog/.venv/bin/pip install -r scripts/catalog/requirements.txt",
    "setup": "bash scripts/setup-local.sh",
    "test": "node scripts/smoke-test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "keywords": [
    "api",
    "marketplace",
    "nextjs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@stripe/stripe-js": "^8.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.3",
    "ioredis": "^5.9.2",
    "js-yaml": "^5.4.2",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.562.0",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.30",
    "postcss": "^8.5.6",
    "prisma": "^6.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.6.0",
    "stripe": "^20.2.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.31.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "tsx": "^4.23.15"
  }
}
